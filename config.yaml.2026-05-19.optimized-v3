healthCheckTimeout: 900
logLevel: info
logToStdout: both
startPort: 19080
includeAliasesInList: false
globalTTL: 1800
apiKeys:
  - LOCAL
macros:
  tq_server: /mnt/local/nvme/ai/runtimes/llama-cpp-turboquant/build/bin/llama-server
  common_args: >
    --host 127.0.0.1
    --port ${PORT}
    --jinja
    --metrics
    --parallel 1
    --cache-type-k turbo3
    --cache-type-v turbo2
    --threads 28
    --threads-batch 56
matrix:
  vars:
    g26: gemma-4-26b-a4b-it
    g31: gemma-4-31b-it
    q122: qwen3.5-122b-a10b
    g4v: glm-4.6v
    gf4: glm-4.7-flash
    gr30: granite-4.1-30b
    n2: nemotron-udq2-128k
    n3: nemotron-udq3-128k
    mx8: minimax-80k
    mx9: minimax-96k
    mx12: minimax-128k
    q35: qwen3.6-35b-a3b
    q27: qwen3.6-27b
    g8: granite-4.1-8b
    q9: qwen3.5-9b
  evict_costs:
    q122: 50
    g4v: 50
    mx8: 60
    mx9: 60
    mx12: 60
    n2: 40
    n3: 40
    q27: 10
    g31: 10
    q35: 5
    g26: 5
    gf4: 5
    gr30: 5
    g8: 1
    q9: 1
  sets:
    colocated: "(g26 | g31 | q122 | g4v | gf4 | gr30 | n2 | n3 | mx8 | mx9 | mx12 | q35 | q27) & (g8 & q9)"
models:
  gemma-4-26b-a4b-it:
    name: Gemma 4 26B A4B IT UD-IQ4_XS
    cmd: >
      ${tq_server} ${common_args}
      --alias gemma-4-26b-a4b-it
      --n-gpu-layers 999
      --ctx-size 131072
      --batch-size 256
      --ubatch-size 32
      --model /mnt/local/nvme/ai/models/gguf/gemma-4-26b-a4b-it-unsloth-ud-iq4-xs/UD-IQ4_XS/gemma-4-26B-A4B-it-UD-IQ4_XS.gguf
  gemma-4-31b-it:
    name: Gemma 4 31B IT IQ4_XS
    cmd: >
      ${tq_server} ${common_args}
      --alias gemma-4-31b-it
      --n-gpu-layers 999
      --ctx-size 131072
      --batch-size 256
      --ubatch-size 32
      --model /mnt/local/nvme/ai/models/gguf/gemma-4-31b-it-iq4_xs/gemma-4-31B-it-IQ4_XS.gguf
  qwen3.5-122b-a10b:
    name: Qwen3.5 122B A10B UD-IQ4_XS
    cmd: >
      ${tq_server} ${common_args}
      --alias qwen3.5-122b-a10b
      --n-gpu-layers 999
      --n-cpu-moe 37
      --ctx-size 131072
      --batch-size 64
      --ubatch-size 16
      --model /mnt/local/nvme/ai/models/gguf/qwen3.5-122b-a10b-unsloth-ud-iq4-xs/UD-IQ4_XS/Qwen3.5-122B-A10B-UD-IQ4_XS-00001-of-00003.gguf
  glm-4.6v:
    name: GLM 4.6V UD-Q3_K_XL
    cmd: >
      ${tq_server} ${common_args}
      --alias glm-4.6v
      --n-gpu-layers 999
      --n-cpu-moe 38
      --ctx-size 131072
      --batch-size 64
      --ubatch-size 16
      --model /mnt/local/nvme/ai/models/gguf/glm-4.6v-unsloth-ud-q3-k-xl/UD-Q3_K_XL/GLM-4.6V-UD-Q3_K_XL-00001-of-00002.gguf
  glm-4.7-flash:
    name: GLM 4.7 Flash UD-Q3_K_XL
    cmd: >
      ${tq_server} ${common_args}
      --alias glm-4.7-flash
      --n-gpu-layers 999
      --ctx-size 131072
      --batch-size 128
      --ubatch-size 32
      --temp 1.0
      --top-p 0.95
      --min-p 0.01
      --repeat-penalty 1.0
      --model /mnt/local/nvme/ai/models/gguf/glm-4.7-flash-unsloth-ud-q3-k-xl/UD-Q3_K_XL/GLM-4.7-Flash-UD-Q3_K_XL.gguf
  granite-4.1-30b:
    name: Granite 4.1 30B UD-Q3_K_XL
    cmd: >
      ${tq_server} ${common_args}
      --alias granite-4.1-30b
      --n-gpu-layers 999
      --ctx-size 81920
      --batch-size 128
      --ubatch-size 32
      --model /mnt/local/nvme/ai/models/gguf/granite-4.1-30b-unsloth-ud-q3-k-xl/UD-Q3_K_XL/granite-4.1-30b-UD-Q3_K_XL.gguf
  granite-4.1-8b:
    name: Granite 4.1 8B UD-Q3_K_XL
    cmd: >
      ${tq_server} ${common_args}
      --alias granite-4.1-8b
      --n-gpu-layers 0
      --ctx-size 131072
      --batch-size 256
      --ubatch-size 32
      --parallel 5
      --model /mnt/local/nvme/ai/models/gguf/granite-4.1-8b-unsloth-ud-q3-k-xl/UD-Q3_K_XL/granite-4.1-8b-UD-Q3_K_XL.gguf
  nemotron-udq2-128k:
    name: NVIDIA Nemotron 3 Super 120B A12B UD-Q2_K_XL
    cmd: >
      ${tq_server} ${common_args}
      --alias nemotron-udq2-128k
      --ctx-size 131072
      --batch-size 64
      --ubatch-size 16
      --n-gpu-layers 999
      --flash-attn on
      --n-cpu-moe 64
      --reasoning-budget 0
      --model /mnt/local/nvme/ai/models/gguf/nemotron-3-super-120b-a12b-unsloth-ud-q2-k-xl/UD-Q2_K_XL/NVIDIA-Nemotron-3-Super-120B-A12B-UD-Q2_K_XL-00001-of-00003.gguf
  nemotron-udq3-128k:
    name: NVIDIA Nemotron 3 Super 120B A12B UD-Q3_K_XL
    cmd: >
      ${tq_server} ${common_args}
      --alias nemotron-udq3-128k
      --ctx-size 131072
      --batch-size 64
      --ubatch-size 16
      --n-gpu-layers 999
      --flash-attn on
      --n-cpu-moe 71
      --reasoning-budget 0
      --model /mnt/local/nvme/ai/models/gguf/nemotron-3-super-120b-a12b-unsloth-ud-q3-k-xl/UD-Q3_K_XL/NVIDIA-Nemotron-3-Super-120B-A12B-UD-Q3_K_XL-00001-of-00003.gguf
  minimax-80k:
    name: MiniMax M2.7 UD-IQ4_XS 80K
    cmd: >
      ${tq_server} ${common_args}
      --alias minimax-80k
      --ctx-size 81920
      --batch-size 64
      --ubatch-size 16
      --n-gpu-layers 999
      --flash-attn on
      --n-cpu-moe 55
      --reasoning-budget 0
      --model /mnt/local/nvme/ai/models/gguf/minimax-m2-7-unsloth-ud-iq4-xs/UD-IQ4_XS/MiniMax-M2.7-UD-IQ4_XS-00001-of-00004.gguf
  minimax-96k:
    name: MiniMax M2.7 UD-IQ4_XS 96K
    cmd: >
      ${tq_server} ${common_args}
      --alias minimax-96k
      --ctx-size 98304
      --batch-size 64
      --ubatch-size 16
      --n-gpu-layers 999
      --flash-attn on
      --n-cpu-moe 56
      --reasoning-budget 0
      --model /mnt/local/nvme/ai/models/gguf/minimax-m2-7-unsloth-ud-iq4-xs/UD-IQ4_XS/MiniMax-M2.7-UD-IQ4_XS-00001-of-00004.gguf
  minimax-128k:
    name: MiniMax M2.7 UD-IQ4_XS 128K
    cmd: >
      ${tq_server} ${common_args}
      --alias minimax-128k
      --ctx-size 128000
      --batch-size 64
      --ubatch-size 16
      --n-gpu-layers 999
      --flash-attn on
