      --reasoning-budget 0
      --model /mnt/local/nvme/ai/models/gguf/minimax-m2-7-unsloth-ud-iq4-xs/UD-IQ4_XS/MiniMax-M2.7-UD-IQ4_XS-00001-of-00004.gguf
  qwen3.6-35b-a3b:
    name: Qwen3.6 35B A3B UD-IQ4_XS
    cmd: >
      ${tq_server} ${common_args}
      --alias qwen3.6-35b-a3b
      --n-gpu-layers 999
      --ctx-size 65536
      --batch-size 256
      --ubatch-size 32
      --model /mnt/local/nvme/ai/models/gguf/qwen3.6-35b-a3b-unsloth-ud-iq4-xs/UD-IQ4_XS/Qwen3.6-35B-A3B-UD-IQ4_XS.gguf
  qwen3.5-9b:
    name: Qwen3.5 9B UD-Q4_K_XL
    cmd: >
      ${tq_server} ${common_args}
      --alias qwen3.5-9b
      --n-gpu-layers 0
      --ctx-size 131072
      --batch-size 256
      --ubatch-size 32
      --parallel 5
      --model /mnt/local/nvme/ai/models/gguf/qwen3.5-9b-unsloth-ud-q4-k-xl/UD-Q4_K_XL/Qwen3.5-9B-UD-Q4_K_XL.gguf
  qwen3.6-27b:
