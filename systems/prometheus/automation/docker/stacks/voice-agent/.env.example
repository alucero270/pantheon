# status: scaffold
# Copy to .env on Prometheus and fill locally. Do not commit real .env files.

TZ=Etc/UTC

# Speaches is the first STT/TTS validation service.
# Use compose.cuda.yml and latest-cuda only after confirming Docker GPU runtime is ready.
SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest-cpu
SPEACHES_BIND=127.0.0.1
SPEACHES_PORT=8000
SPEACHES_CACHE_VOLUME=speaches-hf-hub-cache

# Pipecat quickstart local server default.
PIPECAT_BIND=127.0.0.1
PIPECAT_PORT=7860

# Existing local LLM endpoints on Prometheus.
LLAMA_SWAP_BASE_URL=http://host.docker.internal:8085/v1
LLAMA_SWAP_API_KEY=LOCAL
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Initial model choices. Validate before treating as stable.
STT_MODEL=Systran/faster-distil-whisper-large-v3
TTS_MODEL=hexgrad/Kokoro-82M
LLM_MODEL=REPLACE_WITH_VALIDATED_LLAMA_SWAP_MODEL
