# status: scaffold
# Copy to .env on Prometheus and fill locally. Do not commit real .env files.

TZ=Etc/UTC
PUID=1000
PGID=1000

# Image references use the validated live repositories with placeholder tags.
GLUETUN_IMAGE=qmcgaw/gluetun:REPLACE_WITH_PINNED_TAG
QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent:REPLACE_WITH_PINNED_TAG
PROWLARR_IMAGE=lscr.io/linuxserver/prowlarr:REPLACE_WITH_PINNED_TAG
RADARR_IMAGE=lscr.io/linuxserver/radarr:REPLACE_WITH_PINNED_TAG
SONARR_IMAGE=lscr.io/linuxserver/sonarr:REPLACE_WITH_PINNED_TAG

# VPN settings. Replace locally only.
VPN_SERVICE_PROVIDER=REPLACE_ME
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=REPLACE_ME
WIREGUARD_ADDRESSES=REPLACE_ME
SERVER_COUNTRIES=REPLACE_ME

# Web UI ports. qBittorrent remains localhost-only through Gluetun.
# Prowlarr/Radarr/Sonarr broad binds reflect current temporary live state.
QBITTORRENT_WEBUI_PORT=8080
PROWLARR_BIND=0.0.0.0
PROWLARR_PORT=9696
RADARR_BIND=0.0.0.0
RADARR_PORT=7878
SONARR_BIND=0.0.0.0
SONARR_PORT=8989

# Host paths. Validate before live use.
GLUETUN_CONFIG_PATH=/opt/vpn/gluetun
QBITTORRENT_CONFIG_PATH=/opt/torrents/config
PROWLARR_CONFIG_PATH=/opt/arr/prowlarr
RADARR_CONFIG_PATH=/opt/arr/radarr
SONARR_CONFIG_PATH=/opt/arr/sonarr
MEDIA_DOWNLOADS_PATH=/opt/torrents/downloads
ATLAS_MOVIES_PATH=/mnt/atlas/managed-media/movies
ATLAS_TV_PATH=/mnt/atlas/managed-media/tv
