# status: scaffold
# Copy to .env on Prometheus and fill locally. Do not commit real .env files.

TZ=Etc/UTC

# Legacy Speaches fallback scaffold.
# Not the current installed voice-agent runtime.
SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest-cpu
SPEACHES_BIND=127.0.0.1
SPEACHES_PORT=8000
SPEACHES_CACHE_VOLUME=speaches-hf-hub-cache

# Local Voice API defaults.
VOICE_API_HOST=127.0.0.1
VOICE_API_PORT=8002
VOICE_API_DEVICE=cuda:0
VOICE_API_DTYPE=bfloat16
QWEN3_TTS_PATH=/mnt/local/nvme/ai/models/TTS/Qwen3-TTS/Qwen3-TTS-12Hz-1.7B-CustomVoice
WHISPER_PATH=/mnt/local/nvme/ai/models/stt/whisper/large-v3-turbo
QWEN_SPEAKER=Ryan
QWEN_LANGUAGE=English
# hybrid uses qwen3-tts-triton / faster-qwen3-tts to avoid stock HF generate latency.
QWEN_TTS_BACKEND=hybrid
QWEN_PREWARM_TEXT=OK.
# Validated on Prometheus 2026-05-21.
QWEN_ATTN_IMPLEMENTATION=flash_attention_2

# Pipecat development runner defaults.
PIPECAT_BIND=0.0.0.0
PIPECAT_PORT=7860

# Existing local LLM endpoints on Prometheus.
LOCAL_VOICE_API=http://127.0.0.1:8002
LLAMA_SWAP_URL=http://172.17.0.1:8085/v1
LLAMA_SWAP_KEY=LOCAL
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Initial model choices. Validate before treating as stable.
VOICE_AGENT_LLM_MODEL=granite-4.1-8b-gpu
VOICE_AGENT_MAX_TOKENS=32
VOICE_AGENT_TEMPERATURE=0.4
VOICE_AGENT_START_PROMPT=Greet me in six words.
# Qwen chat models may need thinking disabled so OpenAI chat content is populated.
# Example: {"chat_template_kwargs":{"enable_thinking":false}}
VOICE_AGENT_LLM_EXTRA_JSON=
VOICE_AGENT_TTS_SPEED=1.5
# Pipecat OpenAITTSService validates OpenAI voice names before calling the local API.
# The Local Voice API maps this to QWEN_SPEAKER internally.
VOICE_AGENT_TTS_VOICE=alloy
